; ------------------------------------------------------------
; NPM access template (copy to .npmrc and adapt to your network)
; ------------------------------------------------------------

; Default public registry
registry=https://registry.npmjs.org/

; In corporate networks, you can route through an internal registry/proxy:
; registry=https://npm.company.tld/repository/npm-group/

; Optional scoped registry example:
; @my-scope:registry=https://npm.company.tld/repository/npm-internal/

; Authentication token example for private registries:
; //npm.company.tld/repository/npm-group/:_authToken=${NPM_TOKEN}

; Keep SSL validation enabled. If your company uses a custom CA,
; set it via NODE_EXTRA_CA_CERTS or npm config cafile.
strict-ssl=true

; Proxy examples if required by your network:
; proxy=http://proxy.company.tld:8080
; https-proxy=http://proxy.company.tld:8080

; If your private registry requires auth for all packages:
; always-auth=true
